POSTGRES_USER=japjong
POSTGRES_PASSWORD=japjong_dev
POSTGRES_DB=japjong
POSTGRES_PORT=5433

DATABASE_URL=postgresql://japjong:japjong_dev@localhost:5433/japjong?schema=public

# เลือกช่องทางส่งอีเมล OTP: smtp | resend (เว้นว่างไว้ = อัตโนมัติ: ใช้ smtp ถ้าตั้งค่าไว้ มิฉะนั้นใช้ resend)
EMAIL_PROVIDER=

# Gmail SMTP (Nodemailer + App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Resend API Key สำหรับส่ง Email OTP ยืนยันการลงนามเอกสาร (ใช้สำหรับ Demo หรือโดเมนที่ Verify แล้ว)
# สมัครและรับ API Key ฟรีได้ที่ https://resend.com/api-keys
RESEND_API_KEY=
RESEND_FROM="JapJong อบต. <onboarding@resend.dev>"

# โหมดเดโม (ควบคุมเดโม vs โปรดักชัน: แยก deployment และ DB กัน)
DEMO_MODE=true
NEXT_PUBLIC_DEMO=true
REGISTRATION_OPEN=true
NEXT_PUBLIC_REGISTRATION_OPEN=true
