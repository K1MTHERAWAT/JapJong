POSTGRES_USER=japjong
POSTGRES_PASSWORD=japjong_dev
POSTGRES_DB=japjong
POSTGRES_PORT=5433

DATABASE_URL=postgresql://japjong:japjong_dev@localhost:5433/japjong?schema=public

# Resend API Key สำหรับส่ง Email OTP ยืนยันการลงนามเอกสาร
# สมัครและรับ API Key ฟรีได้ที่ https://resend.com/api-keys
RESEND_API_KEY=
RESEND_FROM="JapJong อบต. <onboarding@resend.dev>"

# โหมดเดโม (ควบคุมเดโม vs โปรดักชัน: แยก deployment และ DB กัน)
DEMO_MODE=true
NEXT_PUBLIC_DEMO=true
