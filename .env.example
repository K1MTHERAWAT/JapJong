POSTGRES_USER=jongwen
POSTGRES_PASSWORD=jongwen_dev
POSTGRES_DB=jongwen
POSTGRES_PORT=5433

DATABASE_URL=postgresql://jongwen:jongwen_dev@localhost:5433/jongwen?schema=public

# Resend API Key สำหรับส่ง Email OTP ยืนยันการลงนามเอกสาร
# สมัครและรับ API Key ฟรีได้ที่ https://resend.com/api-keys
RESEND_API_KEY=
RESEND_FROM="Jongwen อบต.น้ำชำ <onboarding@resend.dev>"

# โหมดเดโม (ควบคุมเดโม vs โปรดักชัน: แยก deployment และ DB กัน)
DEMO_MODE=true
NEXT_PUBLIC_DEMO=true
