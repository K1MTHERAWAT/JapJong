{
  "name": "japjong-booking",
  "private": true,
  "version": "0.1.0",
  "description": "JapJong (จับจอง) · ระบบขอใช้สถานที่ ขอใช้อุปกรณ์ และแจ้งซ่อม (monorepo: Next.js + NestJS + Tailwind)",
  "scripts": {
    "build:shared": "pnpm --filter @japjong/shared build",
    "dev": "pnpm build:shared && pnpm --parallel --filter @japjong/api --filter @japjong/web dev",
    "dev:web": "pnpm --filter @japjong/web dev",
    "dev:api": "pnpm --filter @japjong/api dev",
    "build": "pnpm build:shared && pnpm --filter @japjong/api build && pnpm --filter @japjong/web build",
    "start": "pnpm --parallel --filter @japjong/api --filter @japjong/web start",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "pnpm build:shared && pnpm -r typecheck",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f postgres",
    "db:psql": "docker exec -it japjong-postgres psql -U japjong -d japjong",
    "db:seed": "pnpm --filter @japjong/api prisma:seed",
    "db:clear": "pnpm --filter @japjong/api exec tsx prisma/clear.ts",
    "db:studio": "pnpm --filter @japjong/api prisma:studio"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^5.0.5",
    "prisma": "6.19.3",
    "vitest": "^5.0.5"
  }
}